# FILE: /.env.example
# SplashCreator Environment Configuration

# Database Configuration
DB_HOST=localhost
DB_NAME=splashcreator
DB_USER=root
DB_PASS=

# Application Settings
APP_NAME=SplashCreator
APP_ENV=development
APP_DEBUG=true
BASE_URL=http://localhost/splashcreator

# Security
SESSION_LIFETIME=7200

# File Upload Settings
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=storage/uploads

# AI Generation Limits (per request)
MAX_TEXT_TOKENS=2000
MAX_IMAGE_SIZE=2048
MAX_VIDEO_DURATION=300

# Email Settings (for future use)
MAIL_FROM=noreply@splashcreator.com
MAIL_FROM_NAME=SplashCreator

# Timezone
APP_TIMEZONE=UTC
